# Development Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to your repository!

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_bucket_access_key_id
R2_SECRET_KEY=your_r2_bucket_secret_access_key
R2_BUCKET=your_bucket_name
R2_BUCKET_PUBLIC_DEV_URL=your_public_bucket_url

# Email Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
RECIPIENT_EMAIL=alerts@example.com